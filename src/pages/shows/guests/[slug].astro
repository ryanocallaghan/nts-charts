---
// A repeat guest on NTS's catch-all guests show.
import Base from "../../../layouts/Base.astro";
import ShowBody from "../../../components/ShowBody.astro";
import { ntsShowUrl, plural } from "../../../lib/format.ts";
import { GUESTS_SHOW, guestPages, showDetail, type GuestRow } from "../../../lib/queries.ts";

export function getStaticPaths() {
  return [...guestPages().values()].map((g) => ({ params: { slug: g.slug }, props: { guest: g } }));
}

const { guest } = Astro.props as { guest: GuestRow };
const d = showDetail(GUESTS_SHOW, guest.slug);
---
<Base title={guest.name} description={`${guest.name}'s guest mixes on NTS Radio: tracklists, most-played artists and tracks.`} section="shows">
  <article>
    <p class="eyebrow"><a href="/shows/guests/">Guest</a> · {plural(guest.mixes, "mix", "mixes")}</p>
    <h1>{guest.name}</h1>
    <ShowBody show={GUESTS_SHOW} detail={d} moreHref={ntsShowUrl(GUESTS_SHOW)} episodesLabel="Guest mixes" />
  </article>
</Base>
