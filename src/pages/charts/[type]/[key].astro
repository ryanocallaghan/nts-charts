---
import Base from "../../../layouts/Base.astro";
import ChartView from "../../../components/ChartView.astro";
import { DATED_PERIODS, isoWeekStart, periodBounds, periodDates, periodHeading, periodLabel, switchTargets, typeLabel, type DatedPeriod } from "../../../lib/format.ts";
import { asOf } from "../../../lib/overview.ts";
import PastYears from "../../../components/PastYears.astro";
import ChartFilters from "../../../components/ChartFilters.astro";
import BumpChart from "../../../components/BumpChart.astro";
import RecordGenreNote from "../../../components/RecordGenreNote.astro";
import { byShows, filterDescription, filterLabel, filterPlaces, genreBySlug, hasRecordChart, periodKeys, type ChartFilter } from "../../../lib/queries.ts";

const type = Astro.params.type as DatedPeriod;
const key = Astro.params.key ?? "";
if (!DATED_PERIODS.includes(type)) return new Response(null, { status: 404 });
const keys = periodKeys(type);
const i = keys.indexOf(key);
if (i < 0) return new Response(null, { status: 404 });

// Optional filters: ?genre=<slug>&place=<name>. Not for single weeks, which are too sparse to slice.
// A genre means its records (from Discogs); &by=shows means what's played on shows NTS tags with it.
// A genre with only one kind of chart gets that kind.
const params = Astro.url.searchParams;
const genreParam = params.get("genre") || "";
const placeParam = params.get("place") || "";
const filterable = type !== "week";
if ((genreParam || placeParam) && !filterable) return Astro.redirect(`/charts/${type}/${key}/`, 301);
const genre = genreParam ? genreBySlug(genreParam) : undefined;
const wantShows = params.get("by") === "shows";
const filter: ChartFilter = {
  genre,
  by: genre && (genre.episodes === 0 ? false : wantShows || !hasRecordChart(genre)) ? "shows" : "records",
  place: placeParam && filterPlaces().some((p) => p.name === placeParam) ? placeParam : undefined,
};
if ((genreParam && !filter.genre) || (placeParam && !filter.place)) return new Response(null, { status: 404 });
const filtered = !!(filter.genre || filter.place);
// Links to other charts keep the filter where it applies.
const query = (t: string) => {
  if (!filtered || t === "week") return "";
  const q = new URLSearchParams();
  if (filter.genre) q.set("genre", filter.genre.slug);
  if (filter.genre && byShows(filter)) q.set("by", "shows");
  if (filter.place) q.set("place", filter.place);
  return `?${q}`;
};
const prev = keys[i - 1];
const next = keys[i + 1];

// Switching type keeps you at the same point in time: this chart's end, or the latest data while it's running.
const near = switchTargets(type, key, asOf());
// Same date label as the home page: the whole period, and how far the data goes while it's still running.
const dates = periodDates(type, key, asOf());
const heading = periodHeading(type, key, dates.inProgress);
const sub = [heading.sub.split(" · ")[0], dates.text].filter(Boolean).join(" · ");
// Short labels for previous/next: "Week 46", "October 2026", "2025", or "To 15 Nov" for 4-week charts.
const stepLabel = (k: string) => {
  if (type !== "rolling") return periodLabel(type, k).split(" · ")[0];
  const end = isoWeekStart(k);
  end.setUTCDate(end.getUTCDate() + 6);
  return `To ${end.getUTCDate()} ${end.toLocaleString("en-GB", { month: "short", timeZone: "UTC" })}`;
};
const switchHref = (t: DatedPeriod) => {
  // No chart for that exact period (a gap, or before the charts began): the nearest earlier one, else the first.
  const ks = periodKeys(t);
  const target = ks.includes(near[t]) ? near[t] : (ks.findLast((k) => k <= near[t]) ?? ks[0]);
  return target ? `/charts/${t}/${target}/${query(t)}` : "/charts/";
};
---
<Base title={`${heading.title}${filtered ? ` · ${filterLabel(filter)}` : ""} · ${sub}`} section="charts">
  <h1>{heading.title}{filtered && <span class="filter-heading">{filterLabel(filter)}</span>}</h1>
  <p class="page-sub">{sub}{filtered && ` · ${filterDescription(filter)}`}</p>

  <div class="period-nav">
    <nav class="cds--content-switcher cds--content-switcher--md period-switcher" aria-label="Chart period">
      {DATED_PERIODS.map((t) => (
        <a class:list={["cds--content-switcher-btn", { "cds--content-switcher--selected": t === type }]} href={switchHref(t)} aria-current={t === type ? "page" : undefined}>
          <span class="cds--content-switcher__label">{typeLabel[t]}</span>
        </a>
      ))}
      <a class="cds--content-switcher-btn" href="/charts/all/"><span class="cds--content-switcher__label">All time</span></a>
    </nav>
    <nav class="stepper" aria-label="Previous and next chart">
      {prev ? <a class="cds--link" href={`/charts/${type}/${prev}/${query(type)}`} rel="prev">← {stepLabel(prev)}</a> : <span class="cds--link cds--link--disabled">← Earlier</span>}
      <span class="muted">·</span>
      {next ? <a class="cds--link" href={`/charts/${type}/${next}/${query(type)}`} rel="next">{stepLabel(next)} →</a> : <span class="cds--link cds--link--disabled">Later →</span>}
    </nav>
  </div>

  {filterable && <ChartFilters action={`/charts/${type}/${key}/`} filter={filter} />}
  {filter.genre && !byShows(filter) && <RecordGenreNote genre={filter.genre} range={periodBounds(type, key)} showsHref={filter.genre.episodes > 0 ? `/charts/${type}/${key}/?${new URLSearchParams({ genre: filter.genre.slug, by: "shows", ...(filter.place ? { place: filter.place } : {}) })}` : undefined} />}

  <ChartView type={type} periodKey={key} filter={filtered ? filter : undefined} />

  {(type === "rolling" || type === "week") && !filtered && <BumpChart type={type} periodKey={key} />}

  {type === "week" && <PastYears week={key} />}
  {type === "year" && <p class="section"><a href={`/years/${key}/`}>{key} in review →</a> New artists, biggest climbers, genres and the busiest shows.</p>}
</Base>
