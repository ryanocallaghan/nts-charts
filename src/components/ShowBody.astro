---
// Stats, most-played artists/tracks and recent episodes: shared by show pages and guest pages.
import ArtistLinks from "./ArtistLinks.astro";
import ThemeLabel from "./ThemeLabel.astro";
import PlayPatterns from "./PlayPatterns.astro";
import { formatDate, ntsEpisodeUrl, plural } from "../lib/format.ts";
import { trackHref } from "../lib/search.ts";
import { guestPages, playTimes, showEarlyPlays, similarShows, SHOW_EPISODES_PER_PAGE, themeTunesFor, type showDetail } from "../lib/queries.ts";

// `showKey`: the show alias, or 'guests/<slug>' for a repeat guest (for similar shows and early plays).
// `path`: the page's address, for the episode pages (?page=2 onwards).
interface Props { show: string; showKey: string; detail: ReturnType<typeof showDetail>; episodesLabel?: string; moreHref: string; path: string }
const { show, showKey, detail: d, episodesLabel = "Episodes", moreHref, path } = Astro.props;
const pageHref = (n: number) => (n === 1 ? path : `${path}?page=${n}`);
const from = (d.page - 1) * SHOW_EPISODES_PER_PAGE + 1;
const similar = similarShows(showKey);
const early = showEarlyPlays(showKey);
const guests = guestPages();
const themes = themeTunesFor(d.topTracks.map((t) => t.id));
---
<div class="stats">
  <div class="stat"><div class="label">Episodes with tracklists</div><div class="value">{(d.stats.episodes ?? 0).toLocaleString("en-GB")}</div></div>
  <div class="stat"><div class="label">Plays</div><div class="value">{(d.stats.plays ?? 0).toLocaleString("en-GB")}</div></div>
  <div class="stat"><div class="label">Different tracks</div><div class="value">{(d.stats.tracks ?? 0).toLocaleString("en-GB")}</div></div>
  <div class="stat"><div class="label">On air</div><div class="value" style="font-size:1rem;padding-top:0.4rem">{d.stats.first ? (d.stats.first.slice(0, 10) === d.stats.last.slice(0, 10) ? formatDate(d.stats.first) : `${formatDate(d.stats.first)} – ${formatDate(d.stats.last)}`) : "—"}</div></div>
</div>

<div class="grid-2 section">
  <section class="card">
    <h2>Most-played artists</h2>
    <ul class="plain" data-collapse-list="10">
      {d.topArtists.map((a) => (
        <li><a href={`/artists/${a.slug}/`}>{a.name}</a><span class="count">{plural(a.episodes, "episode")}</span></li>
      ))}
    </ul>
  </section>
  <section class="card">
    <h2>Most-played tracks</h2>
    {d.topTracks.length === 0
      ? <p class="muted">No track has been played in more than one episode yet.</p>
      : <ul class="plain" data-collapse-list="10">
          {d.topTracks.map((t) => (
            <li><span><a href={trackHref(t)}>{t.title}</a> <span class="muted">— {t.artistDisplay}</span><ThemeLabel themes={themes.get(t.id)} /></span><span class="count">{plural(t.episodes, "episode")}</span></li>
          ))}
        </ul>}
  </section>
</div>

{showKey !== "guests" && <PlayPatterns times={playTimes("show", showKey)} />}

<section class="card section" id="episodes">
  <h2>{episodesLabel}</h2>
  {d.pages > 1 && <p class="caption muted">Newest first · {from.toLocaleString("en-GB")}–{(from + d.episodes.length - 1).toLocaleString("en-GB")} of {d.episodeTotal.toLocaleString("en-GB")}</p>}
  {d.episodes.map((e) => (
    <details class="episode">
      <summary>
        <span>{e.name}{e.guest && guests.has(e.guest) && show === "guests" && <> · <a href={`/shows/guests/${e.guest}/`}>{plural(guests.get(e.guest)!.mixes, "mix", "mixes")}</a></>}</span>
        <span class="muted">{formatDate(e.broadcast)} · {e.trackCount ? plural(e.trackCount, "track") : "no tracklist"}</span>
      </summary>
      <ol>
        {(d.tracklists.get(e.alias) ?? []).map((t) => (
          <li><strong><a class="quiet" href={trackHref(t)}>{t.title}</a></strong> — <ArtistLinks artists={t.artists} fallback={t.artistDisplay} /></li>
        ))}
      </ol>
      <a href={ntsEpisodeUrl(show, e.alias)}>Listen to this episode →</a>
    </details>
  ))}
  {d.pages > 1 && (
    <nav class="stepper episode-pager" aria-label="Episode pages">
      {d.page > 1 ? <a class="cds--link" href={`${pageHref(d.page - 1)}#episodes`} rel="prev">← Newer</a> : <span class="cds--link cds--link--disabled">← Newer</span>}
      <span class="muted">Page {d.page} of {d.pages}</span>
      {d.page < d.pages ? <a class="cds--link" href={`${pageHref(d.page + 1)}#episodes`} rel="next">Older →</a> : <span class="cds--link cds--link--disabled">Older →</span>}
    </nav>
  )}
  <p class="muted small" style="margin:0.75rem 0 0"><a href={moreHref}>All episodes on nts.live</a></p>
</section>

{(similar.length > 0 || early.tracks > 0) && (
  <div class="grid-2 section">
    {similar.length > 0 && (
      <section class="card">
        <h2>Similar shows</h2>
        <p class="caption muted">Shows that play many of the same artists</p>
        <ul class="plain" data-collapse-list="10">
          {similar.map((s) => <li><a href={s.href}>{s.name}</a><span class="count">{Math.round(s.score * 100)}% alike</span></li>)}
        </ul>
      </section>
    )}
    {early.tracks > 0 && (
      <section class="card">
        <h2>Ahead of the charts</h2>
        <p class="caption muted">Played {plural(early.tracks, "track")} in the 12 weeks before they first made the weekly chart, on average {early.weeksEarly} weeks early. <a href="/tastemakers/">Tastemakers</a></p>
        <ul class="plain" data-collapse-list="10">
          {early.recent.map((t) => (
            <li><span><a href={trackHref(t)}>{t.title}</a> <span class="muted">— {t.artistDisplay}</span></span><span class="count">{plural(t.weeksEarly, "week")} early</span></li>
          ))}
        </ul>
      </section>
    )}
  </div>
)}
