---
// Home: an overview of the latest 4-week window, with the full tables a click away.
import Base from "../layouts/Base.astro";
import HeroLogo from "../components/HeroLogo.astro";
import HeaderSearch from "../components/HeaderSearch.astro";
import PastYears from "../components/PastYears.astro";
import RankedList from "../components/RankedList.astro";
import Spotlight from "../components/Spotlight.astro";
import StatTile from "../components/StatTile.astro";
import TimeChart from "../components/TimeChart.astro";
import { periodDates, SITE_NAME } from "../lib/format.ts";
import { archiveComplete, asOf, genreMix, genreTrends, headlineStats, movers, spotlight, type Item } from "../lib/overview.ts";
import { artistChart, genreBySlug, periodKeys, trackChart, type ArtistEntry, type TrackEntry } from "../lib/queries.ts";
import { slugify } from "../../ingest/normalize.ts";
import { genreBars, weekShareLine } from "../lib/series.ts";
import { trackHref } from "../lib/search.ts";

const latest = periodKeys("rolling").at(-1);
const latestWeek = periodKeys("week").at(-1);
const chartHref = latest ? `/charts/rolling/${latest}/` : "/charts/";
// While the window is in progress, show the dates the numbers actually cover, not the whole window.
// Same date label as the chart page: the whole window, and how far the data goes while it's still running.
const covered = latest ? periodDates("rolling", latest, asOf()).text : "";

const trackItem = (t: TrackEntry): Item => ({
  rank: t.rank, title: t.title, href: trackHref(t), artists: t.artists, credit: t.artistDisplay, kind: "track",
  status: t.status, prevRank: t.prevRank, count: `${t.score} eps`,
});
const artistItem = (a: ArtistEntry): Item => ({
  rank: a.rank, title: a.name, href: `/artists/${a.slug}/`, kind: "artist",
  status: a.status, prevRank: a.prevRank, count: `${a.score} eps`,
});

const complete = archiveComplete();
const headline = latest ? headlineStats(latest, complete) : [];
const spot = latest ? spotlight(latest) : null;
const top = latest ? { tracks: trackChart("rolling", latest, 5).map(trackItem), artists: artistChart("rolling", latest, 5).map(artistItem) } : null;
const moves = latest ? movers(latest) : null;
const mix = latest ? genreMix(latest) : [];
const genreHref = (name: string) => { const g = genreBySlug(slugify(name.trim())); return g ? `/genres/${g.slug}/` : undefined; };
const trends = latest ? genreTrends(latest) : { series: [], max: 10 };
---
<Base title={SITE_NAME} section="home" hideWordmark>
<div class="home">
  <div class="hero">
    <HeroLogo />
    <div class="hero-text">
      <h2 class="hero-headline">The most-played tracks and artists on NTS Radio</h2>
      <p class="lede">Built from the tracklists of every episode.</p>
      {covered && (
        <p class="hero-meta"><span class="only-wide">Last 4 weeks · </span>{covered}</p>
      )}
      {/* Below 64rem the header has no search box, so a real one goes here instead of the button. */}
      <HeaderSearch id="hero-search" class="hero-search" placeholder="Search artists, shows and tracks" />
      <div class="hero-actions">
        <a class="cds--btn cds--btn--primary cds--btn--md" href={chartHref}>See the full chart</a>
        <a class="cds--btn cds--btn--tertiary cds--btn--md hero-search-btn" href="/search/">Search artists &amp; shows</a>
      </div>
    </div>
  </div>

  {spot && (spot.track || spot.artist) && (
    <section class="section">
      <h2>Number one</h2>
      <p class="section-meta">Last 4 weeks</p>
      <div class="grid-2">
        {spot.track && (
          <Spotlight label="Track" title={spot.track.title} href={trackHref(spot.track)} artists={spot.track.artists} credit={spot.track.artistDisplay}
            episodes={spot.track.score} shows={spot.track.shows} weeksAtOne={spot.track.weeksAtOne} status={spot.track.status} prevRank={spot.track.prevRank} history={spot.track.history} />
        )}
        {spot.artist && (
          <Spotlight label="Artist" title={spot.artist.name} href={`/artists/${spot.artist.slug}/`}
            episodes={spot.artist.score} shows={spot.artist.shows} weeksAtOne={spot.artist.weeksAtOne} status={spot.artist.status} prevRank={spot.artist.prevRank} history={spot.artist.history} />
        )}
      </div>
    </section>
  )}

  {top && (
    <section class="section">
      <h2>Top 5</h2>
      <p class="section-meta">Last 4 weeks</p>
      <div class="grid-2" data-phone-tabs="Top 5">
        <div class="card" data-tab="Tracks">
          <h3>Tracks</h3>
          <RankedList items={top.tracks} movement />
          <p class="more"><a href={chartHref}>See the full chart →</a></p>
        </div>
        <div class="card" data-tab="Artists">
          <h3>Artists</h3>
          <RankedList items={top.artists} movement />
          <p class="more"><a href={`${chartHref}#artists`}>See the full chart →</a></p>
        </div>
      </div>
    </section>
  )}

  {moves && (moves.climbers.length > 0 || moves.entries.length > 0) && (
    <section class="section">
      <h2>On the move</h2>
      <p class="section-meta">4-week chart, compared with last week's · <a href="/tastemakers/">who played them first</a></p>
      <div class="grid-2" data-phone-tabs="On the move">
        {moves.climbers.length > 0 && (
          <div class="card" data-tab="Climbers">
            <h3>Biggest climbers</h3>
            <RankedList items={moves.climbers} movement showKind />
          </div>
        )}
        {moves.entries.length > 0 && (
          <div class="card" data-tab="New entries">
            <h3>New entries</h3>
            <RankedList items={moves.entries} movement showKind />
          </div>
        )}
      </div>
    </section>
  )}

  {headline.length > 0 && (
    <section class="section">
      <h2>In numbers</h2>
      <p class="section-meta">Last 4 weeks, compared with the 4 weeks before</p>
      <div class="stats headline" aria-label="Last 4 weeks in numbers">
        {headline.map((st) => <StatTile stat={st} />)}
      </div>
    </section>
  )}

  {mix.length > 0 && (
    <section class="section">
      <h2>Genre mix</h2>
      <p class="section-meta"><a href="/genres/">All genres, and how they've shifted since 2011</a></p>
      <TimeChart title="Top genres" caption="Share of episodes tagged with each genre, last 4 weeks. Hover for the change vs the previous 4 weeks." data={genreBars(mix)} height={Math.max(220, mix.length * 30)} />
    </section>
  )}

  {trends.series.length > 0 && (
    <section class="section">
      <h2>Genre trends</h2>
      <p class="section-meta">Last 4 weeks, week by week: share of each week's episodes. All charts use the same scale.</p>
      <div class="multiples">
        {trends.series.map((t) => <TimeChart title={t.genre} href={genreHref(t.genre)} data={weekShareLine(t.weeks, t.shares, trends.max)} height={140} />)}
      </div>
    </section>
  )}

  {latestWeek && <PastYears week={latestWeek} />}

  <section class="section more-links">
    <h2>More charts</h2>
    <div class="hero-actions more-actions">
      <a class="cds--btn cds--btn--primary cds--btn--md" href={chartHref}>See the full 4-week chart</a>
      <a class="cds--btn cds--btn--tertiary cds--btn--md" href="/charts/all/">All-time chart</a>
      <a class="cds--btn cds--btn--tertiary cds--btn--md" href="/charts/">Browse the archive</a>
    </div>
  </section>
</div>
</Base>

<script>
  import "../scripts/phone-tabs.ts";
</script>
