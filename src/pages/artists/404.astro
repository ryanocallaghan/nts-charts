---
// Served by Cloudflare Pages for any /artists/<slug>/ without a pre-built page (build-data.ts renames
// this to artists/404.html). Renders the artist in the browser from its data shard.
import Base from "../../layouts/Base.astro";
---
<Base title="Artist" description="An artist played on NTS Radio: tracks, the episodes and shows that played them.">
  <article id="artist" aria-busy="true">
    <p class="eyebrow">Artist</p>
    <h1 id="artist-name">Loading…</h1>
    <noscript><p class="muted">This artist page needs JavaScript. Try <a href="/search/">search</a>.</p></noscript>
  </article>
</Base>

<script>
  import { observeViz } from "../../scripts/charts.ts";
  import { artistShard } from "../../lib/shard.ts";
  import { formatDate, ntsEpisodeUrl, plural } from "../../lib/format.ts";
  import { monthlyBars } from "../../lib/series.ts";
  import type { ArtistShard, LongtailArtist } from "../../lib/longtail-types.ts";

  const root = document.getElementById("artist")!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const n = (v: number) => v.toLocaleString("en-GB");

  function notFound() {
    document.title = "Not found · NTS Charts";
    root.innerHTML = `<h1>Artist not found</h1><p class="lede">We couldn't find that artist. Try <a href="/search/">search</a>.</p>`;
    root.removeAttribute("aria-busy");
  }

  function fillMonths(rows: [string, number][]) {
    if (!rows.length) return [];
    const by = new Map(rows);
    const out: { month: string; episodes: number }[] = [];
    let [y, m] = rows[0][0].split("-").map(Number);
    const last = rows[rows.length - 1][0];
    for (;;) {
      const key = `${y}-${String(m).padStart(2, "0")}`;
      out.push({ month: key, episodes: by.get(key) ?? 0 });
      if (key >= last) break;
      if (++m > 12) { m = 1; y++; }
    }
    return out;
  }

  function render(a: LongtailArtist, shard: ArtistShard) {
    document.title = `${a.n} · NTS Charts`;
    const ep = (i: number) => {
      const [show, date, name, alias] = shard.ep[i];
      const [showName, showHref] = shard.sh[show] ?? [show, `/shows/${show}/`];
      const showLink = name.toLowerCase().includes(showName.toLowerCase())
        ? "" : `<span class="muted"> · <a class="quiet" href="${esc(showHref)}">${esc(showName)}</a></span>`;
      return { html: `<time datetime="${date}">${formatDate(date)}</time><span><a href="${esc(ntsEpisodeUrl(show, alias))}">${esc(name)}</a>${showLink}</span>` };
    };
    const tracks = a.t.map(([title, credit, total, eps, themes]) => {
      const theme = themes?.length
        ? `<span class="theme" title="Opens or closes most episodes of this show, so those plays don't count towards charts">theme tune of ${themes.map(([n, h]) => `<a href="${esc(h)}">${esc(n)}</a>`).join(", ")}</span>`
        : "";
      const list = eps.map((i) => `<li>${ep(i).html}</li>`).join("");
      const more = total > eps.length ? `<p class="muted">and ${plural(total - eps.length, "earlier episode")}</p>` : "";
      return `<li><span>${esc(title)}${credit ? `<span class="muted"> — ${esc(credit)}</span>` : ""}${theme}
        <details class="plays"><summary>Episodes</summary><ul>${list}</ul>${more}</details></span>
        <span class="count">${plural(total, "episode")}</span></li>`;
    }).join("");
    const shows = a.h.map(([s, c]) => {
      const [name, href] = shard.sh[s] ?? [s, `/shows/${s}/`];
      const guest = s.startsWith("guests/") ? `<span class="muted"> · guest</span>` : "";
      return `<li><span><a href="${esc(href)}">${esc(name)}</a>${guest}</span><span class="count">${plural(c, "episode")}</span></li>`;
    }).join("");
    const recent = [...new Set(a.t.flatMap(([title, , , eps]) => eps.map((i) => [i, title] as const)))]
      .sort((x, y) => shard.ep[y[0]][1].localeCompare(shard.ep[x[0]][1]))
      .slice(0, 20)
      .map(([i, title]) => { const e = shard.ep[i]; return `<li><span>${esc(title)} <span class="muted">on</span> <a href="${esc(ntsEpisodeUrl(e[0], e[3]))}">${esc(e[2])}</a></span><span class="count">${formatDate(e[1])}</span></li>`; })
      .join("");
    const viz = monthlyBars(fillMonths(a.m));

    root.innerHTML = `
      <p class="eyebrow">Artist</p>
      <h1>${esc(a.n)}</h1>
      <div class="stats">
        <div class="stat"><div class="label">Episodes</div><div class="value">${n(a.e)}</div></div>
        <div class="stat"><div class="label">Shows</div><div class="value">${n(a.s)}</div></div>
        <div class="stat"><div class="label">Tracks played</div><div class="value">${n(a.k)}</div></div>
        <div class="stat"><div class="label">Peak weekly rank</div><div class="value">${a.p ? `#${a.p}` : "—"}</div></div>
      </div>
      <p class="muted section" style="margin-top:0.75rem">${a.f === a.l ? `Played ${formatDate(a.f)}` : `First played ${formatDate(a.f)} · most recently ${formatDate(a.l)}`}</p>
      ${a.m.length > 1 ? `<section class="card viz-card section"><h2>Plays over time</h2><p class="caption">Episodes that played them, per month</p>
        <div class="viz" style="height:260px" data-viz="${esc(JSON.stringify(viz))}" role="img" aria-label="Plays over time"></div></section>` : ""}
      <div class="grid-2 section">
        <section class="card"><h2>Most-played tracks</h2><ul class="plain">${tracks}</ul></section>
        <section class="card"><h2>Shows that play them</h2><ul class="plain">${shows}</ul></section>
      </div>
      <section class="card section"><h2>Recent plays</h2><ul class="plain">${recent}</ul></section>`;
    root.removeAttribute("aria-busy");
    observeViz(root);
  }

  const slug = decodeURIComponent(location.pathname.split("/").filter(Boolean)[1] ?? "");
  if (!slug) notFound();
  else
    fetch(`/data/artists/${artistShard(slug)}.json`)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((shard: ArtistShard) => (shard.a[slug] ? render(shard.a[slug], shard) : notFound()))
      .catch(notFound);
</script>
