---
import Base from "../../layouts/Base.astro";
import ArtistAbout from "../../components/ArtistAbout.astro";
import EpisodePlays from "../../components/EpisodePlays.astro";
import ThemeLabel from "../../components/ThemeLabel.astro";
import TimeChart from "../../components/TimeChart.astro";
import PlayPatterns from "../../components/PlayPatterns.astro";
import { formatDate, ntsEpisodeUrl, plural } from "../../lib/format.ts";
import { artistBySlug, artistDetail, artistFirstPlay, artistInfo, artistShowLinks, episodesForTracks, playTimes, relatedArtists, themeTunesFor } from "../../lib/queries.ts";
import { connectionsGraph, monthlyBars, rankLine } from "../../lib/series.ts";
import { trackHref } from "../../lib/search.ts";

const artist = artistBySlug(Astro.params.slug ?? "");
if (!artist) return new Response(null, { status: 404 }); // Astro serves src/pages/404.astro
const d = artistDetail(artist.id);
const info = artistInfo(artist.id);
const plays = episodesForTracks(d.topTracks.map((t) => t.id));
const themes = themeTunesFor(d.topTracks.map((t) => t.id));
const first = artistFirstPlay(artist.id);
const related = relatedArtists(artist.id);
const GRAPH_EACH = 8;
const graphShows = d.shows.slice(0, GRAPH_EACH);
const graphArtists = related.slice(0, GRAPH_EACH);
const graph = related.length
  ? connectionsGraph(artist, graphShows, graphArtists, artistShowLinks(graphArtists.map((a) => a.id), graphShows.map((s) => s.key)))
  : null;
const peak = d.chartHistory.length ? Math.min(...d.chartHistory.map((h) => h.rank)) : null;
---
<Base title={artist.name} description={`${artist.name} on NTS Radio: most-played tracks, the shows that play them, and chart history.`}>
  <article>
    <p class="eyebrow">Artist</p>
    <h1>{artist.name}</h1>
    <ArtistAbout info={info} />

    <div class="stats">
      <div class="stat"><div class="label">Episodes</div><div class="value">{d.stats.episodes.toLocaleString("en-GB")}</div></div>
      <div class="stat"><div class="label">Shows</div><div class="value">{d.stats.shows.toLocaleString("en-GB")}</div></div>
      <div class="stat"><div class="label">Tracks played</div><div class="value">{d.stats.tracks.toLocaleString("en-GB")}</div></div>
      <div class="stat"><div class="label">Peak weekly rank</div><div class="value">{peak ? `#${peak}` : "—"}</div></div>
    </div>
    {first && (
      <p class="section first-play">
        First played on NTS by <a href={first.by.href}>{first.by.name}</a>, {formatDate(first.episode.broadcast)}{" "}
        <span class="muted">(<a class="quiet" href={first.episode.href}>{first.episode.name}</a>)</span>
        {d.stats.last && d.stats.last.slice(0, 10) !== first.episode.broadcast.slice(0, 10) && <span class="muted"> · most recently {formatDate(d.stats.last)}</span>}
      </p>
    )}

    <div class="grid-2 section">
      <TimeChart title="Plays over time" caption="Episodes that played them, per month" data={monthlyBars(d.monthly)} />
      {d.chartHistory.length > 0
        ? <TimeChart title="Weekly chart history" caption={`${plural(d.chartHistory.length, "week")} in the Top 50 artists`} data={rankLine(d.chartHistory)} />
        : <section class="card"><h2>Weekly chart history</h2><p class="muted">Hasn't made the weekly Top 50 yet.</p></section>}
    </div>

    <PlayPatterns times={playTimes("artist", artist.id)} subject="them" />

    <div class="grid-2 section">
      <section class="card">
        <h2>Most-played tracks</h2>
        <ul class="plain" data-collapse-list="10">
          {d.topTracks.map((t) => (
            <li>
              <span>
                <a href={trackHref(t)}>{t.title}</a>{t.artistDisplay !== artist.name && <span class="muted"> — {t.artistDisplay}</span>}
                <ThemeLabel themes={themes.get(t.id)} />
                <EpisodePlays plays={plays.get(t.id)} label="Episodes" />
              </span>
              <span class="count">{plural(t.episodes, "episode")}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="card">
        <h2>Shows that play them</h2>
        <ul class="plain">
          {d.shows.map((s) => (
            <li><span><a href={s.href}>{s.name}</a>{s.guest && <span class="muted"> · guest</span>}</span><span class="count">{plural(s.episodes, "episode")}</span></li>
          ))}
        </ul>
      </section>
    </div>

    {graph && (
      <div class="grid-2 section">
        <section class="card viz-card">
          <h2>Connections</h2>
          <p class="caption">Their top shows <span class="key key-show"></span> and the artists most often played alongside them <span class="key key-artist"></span>, linked where they share episodes. Click to explore.</p>
          <div class="viz" style="height:380px" data-viz={JSON.stringify(graph)} role="img" aria-label={`Connections between ${artist.name}, their top shows and related artists. Listed alongside.`}></div>
        </section>
        <section class="card">
          <h2>Often played alongside</h2>
          <p class="caption muted">Artists played in the same episodes, relative to how much each is played</p>
          <ul class="plain">
            {related.map((r) => <li><a href={`/artists/${r.slug}/`}>{r.name}</a><span class="count">{r.shared.toLocaleString("en-GB")} shared episodes</span></li>)}
          </ul>
        </section>
      </div>
    )}

    <section class="card section">
      <h2>Recent plays</h2>
      <ul class="plain">
        {d.recent.map((r) => (
          <li>
            <span><a class="quiet" href={trackHref(r)}>{r.title}</a> <span class="muted">on</span> <a href={ntsEpisodeUrl(r.show, r.episode)}>{r.name}</a></span>
            <span class="count">{formatDate(r.broadcast)}</span>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>

<script>
  import "../../scripts/collapse.ts";
</script>
