---
import "../styles/carbon.scss";
import "../styles/global.css";
import { formatDate, SITE_NAME } from "../lib/format.ts";
import { lastUpdated } from "../lib/queries.ts";

interface Props {
  title: string;
  description?: string;
  section?: "charts" | "all" | "archive" | "shows" | "search";
}
const { title, description = "Charts of the tracks and artists played on NTS Radio.", section } = Astro.props;
const updated = lastUpdated();
const nav = [
  { href: "/", label: "Latest", key: "charts" },
  { href: "/charts/all/", label: "All time", key: "all" },
  { href: "/charts/", label: "Archive", key: "archive" },
  { href: "/shows/", label: "Shows", key: "shows" },
  { href: "/search/", label: "Search", key: "search" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="cds--header site-header" aria-label={SITE_NAME}>
      <a class="cds--header__name site-logo" href="/"><img src="/logo.svg" alt={SITE_NAME} width="53" height="40" /></a>
      <nav class="cds--header__nav" aria-label="Main">
        <ul class="cds--header__menu-bar">
          {nav.map((n) => (
            <li>
              <a class:list={["cds--header__menu-item", { "cds--header__menu-item--current": section === n.key }]} href={n.href} aria-current={section === n.key ? "page" : undefined}>
                <span class="cds--text-truncate--end">{n.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          A personal project built from public NTS Radio tracklists. Not affiliated with NTS.
          Listen at <a href="https://www.nts.live">nts.live</a>.
        </p>
        {updated && <p>Data updated {formatDate(updated)}.</p>}
      </div>
    </footer>
  </body>
</html>
