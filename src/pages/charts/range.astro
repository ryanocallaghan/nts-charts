---
// A chart for any dates: /charts/range/?from=2019-06-01&to=2019-08-31 (both days included), with the
// same filters as other charts. Ranked like every chart, on request (in a worker thread, as a long
// range takes seconds), with arrows against the same number of days just before. Up to 3 years.
// Pick the dates with the fields (no JavaScript needed), a shortcut, or by dragging across the timeline.
import Base from "../../layouts/Base.astro";
import ChartView from "../../components/ChartView.astro";
import ChartFilters from "../../components/ChartFilters.astro";
import PeriodSwitcher from "../../components/PeriodSwitcher.astro";
import RangeTimeline from "../../components/RangeTimeline.astro";
import RecordGenreNote from "../../components/RecordGenreNote.astro";
import { FIRST_VALID_DATE } from "../../lib/dates.ts";
import { dateRange, dayKey, formatDate, parseDay, plural } from "../../lib/format.ts";
import { asOf } from "../../lib/overview.ts";
import { byShows, chartHrefsAt, filterDescription, filterLabel, filterParams, isFiltered, parseChartFilter, rangeChart } from "../../lib/queries.ts";
import { DAY, dayRange, parseRange, rangeBefore, rangeParams, rangeYearsBefore, type DayRange } from "../../lib/ranges.ts";

const params = Astro.url.searchParams;
const filter = parseChartFilter(params);
if (!filter) return new Response(null, { status: 404 });
const filtered = isFiltered(filter);
const keep = filterParams(filter);

// The charts' first and latest days; without dates, the last 30 days.
const bounds = { first: parseDay(FIRST_VALID_DATE)!, last: parseDay(dayKey(asOf()))! };
const parsed = params.has("from") || params.has("to")
  ? parseRange(params.get("from"), params.get("to"), bounds)
  : dayRange(new Date(bounds.last.getTime() - 29 * DAY), bounds.last);
const range = "problem" in parsed ? null : parsed;
const problem = "problem" in parsed ? parsed.problem : "";
if (problem) Astro.response.status = 400;
const previous = range ? rangeBefore(range, bounds.first) : null;
const chart = range ? await rangeChart(filter, range.start, range.end, previous && { start: previous.start, end: previous.end }) : null;

const href = (r: DayRange, extra: Record<string, string> = keep) => `/charts/range/?${new URLSearchParams({ ...rangeParams(r), ...extra })}`;
const shortcuts = [
  { label: "Last 7 days", days: 7 },
  { label: "Last 30 days", days: 30 },
  { label: "Last 90 days", days: 90 },
  { label: "Last 12 months", days: 365 },
  { label: "This year", days: Math.round((bounds.last.getTime() - Date.UTC(bounds.last.getUTCFullYear(), 0, 1)) / DAY) + 1 },
].map((s) => {
  const r = dayRange(new Date(bounds.last.getTime() - (s.days - 1) * DAY), bounds.last);
  return { label: s.label, href: href(r), current: !!range && dayKey(r.start) === dayKey(range.start) && dayKey(r.last) === dayKey(range.last) };
});
// Comparisons: this range against the days before, and against the same days a year earlier.
const compareHref = (first: DayRange) => `/charts/compare/?${new URLSearchParams({ ...rangeParams(first, "a_"), ...rangeParams(range!, "b_"), ...keep })}`;
const yearBefore = range ? rangeYearsBefore(range, 1, bounds.first) : null;

const title = range ? dateRange(range.start, range.last) : "Pick dates";
const sub = range
  ? [`Chart for ${plural(range.days, "day")}`, previous ? `arrows compare with the ${plural(range.days, "day")} before` : "", filtered ? filterDescription(filter) : ""].filter(Boolean).join(" · ")
  : "A chart for any dates";
---
<Base title={`${title}${filtered ? ` · ${filterLabel(filter)}` : ""} · Chart for any dates`} description="A chart of the tracks and artists played on NTS Radio between any two dates." section="charts" noindex>
  <h1>{title}{filtered && range && <span class="filter-heading">{filterLabel(filter)}</span>}</h1>
  <p class="page-sub">{sub}</p>

  <div class="period-nav">
    <PeriodSwitcher hrefs={chartHrefsAt(range?.last ?? bounds.last, filter)} rangeHref={Astro.url.pathname + Astro.url.search} current="range" />
  </div>

  <form class="range-form" action="/charts/range/" method="get">
    {Object.entries(keep).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    <div class="cds--form-item">
      <label class="cds--label" for="range-from">From</label>
      <input class="cds--text-input" type="date" id="range-from" name="from" required min={FIRST_VALID_DATE} max={dayKey(bounds.last)} value={range ? dayKey(range.start) : (params.get("from") ?? "")} />
    </div>
    <div class="cds--form-item">
      <label class="cds--label" for="range-to">To</label>
      <input class="cds--text-input" type="date" id="range-to" name="to" required min={FIRST_VALID_DATE} max={dayKey(bounds.last)} value={range ? dayKey(range.last) : (params.get("to") ?? "")} />
    </div>
    <button type="submit" class="cds--btn cds--btn--primary cds--btn--md">Show chart</button>
  </form>
  <ul class="range-shortcuts" aria-label="Shortcuts">
    {shortcuts.map((s) => <li><a class="cds--link" href={s.href} aria-current={s.current ? "page" : undefined}>{s.label}</a></li>)}
  </ul>

  <RangeTimeline selected={range} lastDay={bounds.last} query={keep} />

  {problem ? (
    <div class="card section range-problem" role="alert">
      <p><strong>{problem}</strong> A chart covers up to 3 years, between {formatDate(bounds.first.toISOString())} and {formatDate(bounds.last.toISOString())}.</p>
      <p>For longer, see the <a href="/charts/">yearly charts</a> or the <a href="/charts/all/">all-time chart</a>.</p>
    </div>
  ) : (
    <>
      <ChartFilters action="/charts/range/" filter={filter} keep={rangeParams(range!)} />
      {filter.genre && !byShows(filter) && <RecordGenreNote genre={filter.genre} range={{ start: range!.start, end: range!.end }} showsHref={filter.genre.episodes > 0 ? href(range!, { ...keep, by: "shows" }) : undefined} />}
      {(previous || yearBefore) && (
        <p class="range-compare small">Compare side by side with
          {previous && <> <a href={compareHref(previous)}>the {plural(range!.days, "day")} before</a></>}
          {previous && yearBefore && " or"}
          {yearBefore && <> <a href={compareHref(yearBefore)}>the same dates a year earlier</a></>}
        </p>
      )}
      <ChartView type="all" periodKey="all" limit={50} filter={filtered ? filter : undefined} range={{ start: range!.start, end: range!.end, tracks: chart!.tracks, artists: chart!.artists, movement: !!previous }} />
    </>
  )}
</Base>
