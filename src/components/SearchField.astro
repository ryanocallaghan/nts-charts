---
// Carbon search field (magnifier icon, large size). Extra attributes (id, data-filter, autofocus…) go on the input.
interface Props { label: string; placeholder?: string; id?: string; [attr: string]: unknown }
const { label, placeholder = label, id = `search-${Math.random().toString(36).slice(2, 8)}`, ...attrs } = Astro.props;
---
<div class="cds--search cds--search--lg search-field">
  <div class="cds--search-magnifier" aria-hidden="true">
    <svg class="cds--search-magnifier-icon" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
      <path d="M15,14.3L10.7,10c1.9-2.3,1.6-5.8-0.7-7.7S4.2,0.7,2.3,3S0.7,8.8,3,10.7c2,1.7,5,1.7,7,0l4.3,4.3L15,14.3z M2,6.5C2,4,4,2,6.5,2S11,4,11,6.5S9,11,6.5,11S2,9,2,6.5z"></path>
    </svg>
  </div>
  <label class="cds--label" for={id}>{label}</label>
  <input class="cds--search-input" type="search" id={id} placeholder={placeholder} autocomplete="off" {...attrs} />
</div>
