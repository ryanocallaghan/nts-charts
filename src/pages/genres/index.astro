---
// Every genre NTS tags episodes with: how the biggest have shifted over time, and the full list.
import Base from "../../layouts/Base.astro";
import GenreRiver from "../../components/GenreRiver.astro";
import SearchField from "../../components/SearchField.astro";
import { plural } from "../../lib/format.ts";
import { allGenres, genreRiver } from "../../lib/queries.ts";
import { genreStack } from "../../lib/series.ts";

const LIST_MIN = 10; // genres with fewer episodes are mostly one-off tags
const genres = allGenres().filter((g) => g.episodes >= LIST_MIN);
const river = genreRiver();
---
<Base title="Genres" description="The genres NTS Radio tags its episodes with: how they've shifted since 2011, and the most-played tracks and artists in each." section="genres">
  <h1>Genres</h1>
  <p class="lede">From the genre tags NTS gives each episode. Charts can also be narrowed to a genre.</p>

  <div class="section"><GenreRiver data={genreStack(river)} slugs={river.series.map((s) => s.slug)} others={river.others} /></div>

  <section class="section">
    <h2>All genres</h2>
    <p class="section-meta">{plural(genres.length, "genre")} with at least {LIST_MIN} episodes, most-tagged first</p>
    <SearchField label="Filter genres" placeholder="Filter genres…" data-filter />
    <ul class="plain columns" data-filter-list>
      {genres.map((g) => <li data-text={g.name.toLowerCase()}><a href={`/genres/${g.slug}/`}>{g.name}</a><span class="count">{plural(g.episodes, "episode")}</span></li>)}
    </ul>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-filter]")!;
  const items = [...document.querySelectorAll<HTMLElement>("[data-filter-list] li")];
  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    for (const li of items) li.hidden = !!q && !li.dataset.text!.includes(q);
  });
</script>

<script>
  import "../../scripts/charts.ts";
</script>
