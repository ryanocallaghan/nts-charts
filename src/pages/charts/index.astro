---
import Base from "../../layouts/Base.astro";
import { formatDate, periodLabel } from "../../lib/format.ts";
import { periodKeys, siteStats } from "../../lib/queries.ts";

const stats = siteStats();

const years = [...periodKeys("year")].reverse();
const months = periodKeys("month");
const quarters = periodKeys("quarter");
const weeks = periodKeys("week");
const byYear = years.map((y) => ({
  year: y,
  months: months.filter((m) => m.startsWith(`${y}-`)).reverse(),
  quarters: quarters.filter((q) => q.startsWith(`${y}-Q`)).reverse(),
  weeks: weeks.filter((w) => w.startsWith(`${y}-W`)).reverse(),
}));
---
<Base title="Chart archive" section="archive">
  <h1>Chart archive</h1>
  <p class="lede">Every weekly, monthly, quarterly and yearly chart, newest first. Each week also has a 4-week chart (switch on any weekly chart). Or see the <a href="/charts/all/">all-time chart</a>.</p>
  <div class="stats" aria-label="Archive size">
    <div class="stat"><div class="label">Episodes with tracklists</div><div class="value">{stats.episodes.toLocaleString("en-GB")}</div></div>
    <div class="stat"><div class="label">Plays</div><div class="value">{stats.plays.toLocaleString("en-GB")}</div></div>
    <div class="stat"><div class="label">Tracks</div><div class="value">{stats.tracks.toLocaleString("en-GB")}</div></div>
    <div class="stat"><div class="label">Artists</div><div class="value">{stats.artists.toLocaleString("en-GB")}</div></div>
  </div>
  <p class="muted small" style="margin-top:0.75rem">Since {stats.first ? formatDate(stats.first) : "the start"}. See also the <a href="/tastemakers/">tastemakers</a>: the shows that play tracks before they chart.</p>


  {byYear.map(({ year, months, quarters, weeks }) => (
    <section class="card section">
      <h2><a href={`/charts/year/${year}/`}>{year}</a></h2>
      <p><a href={`/years/${year}/`}>{year} in review →</a></p>
      {quarters.length > 0 && (
        <p><span class="muted">Quarters:</span> {quarters.map((q, i) => <>{i > 0 && " · "}<a href={`/charts/quarter/${q}/`}>{q.split("-")[1]}</a></>)}</p>
      )}
      {months.length > 0 && (
        <p><span class="muted">Months:</span> {months.map((m, i) => <>{i > 0 && " · "}<a href={`/charts/month/${m}/`}>{periodLabel("month", m).split(" ")[0].slice(0, 3)}</a></>)}</p>
      )}
      {weeks.length > 0 && (
        <details>
          <summary class="muted">{weeks.length} weekly charts</summary>
          <ul class="plain">
            {weeks.map((w) => <li><a href={`/charts/week/${w}/`}>{periodLabel("week", w)}</a></li>)}
          </ul>
        </details>
      )}
    </section>
  ))}
</Base>
