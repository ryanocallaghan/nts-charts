---
// Home: an overview of the latest 4-week window, with the full tables a click away.
import Base from "../layouts/Base.astro";
import HeroLogo from "../components/HeroLogo.astro";
import RankedList from "../components/RankedList.astro";
import Spotlight from "../components/Spotlight.astro";
import StatTile from "../components/StatTile.astro";
import TimeChart from "../components/TimeChart.astro";
import { compareWindows, currentPeriodKey, dateRange, formatDate, isoWeekStart, periodLabel, SITE_NAME } from "../lib/format.ts";
import { archiveComplete, asOf, genreMix, genreTrends, headlineStats, movers, onThisDay, spotlight, type Item } from "../lib/overview.ts";
import { artistChart, periodKeys, siteStats, trackChart, type ArtistEntry, type TrackEntry } from "../lib/queries.ts";
import { genreBars, shareLine } from "../lib/series.ts";

const latest = periodKeys("rolling").at(-1);
const latestWeek = periodKeys("week").at(-1);
const inProgress = latest === currentPeriodKey("rolling");
const stats = siteStats();
const chartHref = latest ? `/charts/rolling/${latest}/` : "/charts/";
// While the window is in progress, show the dates the numbers actually cover, not the whole window.
const covered = latest ? compareWindows(latest, asOf()).current : null;
const windowEnd = latest ? new Date(isoWeekStart(latest).getTime() + 6 * 86_400_000) : null;
const endLabel = windowEnd ? `${windowEnd.getUTCDate()} ${windowEnd.toLocaleString("en-GB", { month: "short", timeZone: "UTC" })}` : "";

const trackItem = (t: TrackEntry): Item => ({
  rank: t.rank, title: t.title, artists: t.artists, credit: t.artistDisplay, kind: "track",
  status: t.status, prevRank: t.prevRank, count: `${t.score} eps`,
});
const artistItem = (a: ArtistEntry): Item => ({
  rank: a.rank, title: a.name, href: a.slug ? `/artists/${a.slug}/` : undefined, kind: "artist",
  status: a.status, prevRank: a.prevRank, count: `${a.score} eps`,
});

const complete = archiveComplete();
const headline = latest ? headlineStats(latest, complete) : [];
const spot = latest ? spotlight(latest) : null;
const top = latest ? { tracks: trackChart("rolling", latest, 5).map(trackItem), artists: artistChart("rolling", latest, 5).map(artistItem) } : null;
const moves = latest ? movers(latest) : null;
const mix = latest ? genreMix(latest) : [];
const trends = genreTrends();
const history = latestWeek ? onThisDay(latestWeek) : [];
const allTime = { tracks: trackChart("all", "all", 5).map(trackItem), artists: artistChart("all", "all", 5).map(artistItem) };
---
<Base title={SITE_NAME} section="home" hideWordmark>
<div class="home">
  <div class="hero">
    <HeroLogo />
    <div class="hero-text">
      <h2 class="hero-period">{latest ? "Last 4 weeks" : "No charts yet"}</h2>
      {covered && (
        <p class="page-sub">
          {dateRange(new Date(covered.from), new Date(new Date(covered.to).getTime() - 1))}
          {inProgress && <span class="cds--tag cds--tag--sm cds--tag--outline">In progress, runs to {endLabel}</span>}
        </p>
      )}
      <p class="lede">What NTS Radio has been playing, from the tracklists of every episode. Tracks and artists score once per episode that plays them.</p>
      <div class="hero-actions">
        <a class="cds--btn cds--btn--primary cds--btn--md" href={chartHref}>See the full chart</a>
        <a class="cds--btn cds--btn--tertiary cds--btn--md" href="/search/">Search artists &amp; shows</a>
      </div>
    </div>
  </div>

  {spot && (spot.track || spot.artist) && (
    <section class="section">
      <h2>Number one</h2>
      <div class="grid-2">
        {spot.track && (
          <Spotlight label="Track" title={spot.track.title} artists={spot.track.artists} credit={spot.track.artistDisplay}
            episodes={spot.track.score} shows={spot.track.shows} weeksAtOne={spot.track.weeksAtOne} status={spot.track.status} prevRank={spot.track.prevRank} history={spot.track.history} />
        )}
        {spot.artist && (
          <Spotlight label="Artist" title={spot.artist.name} href={spot.artist.slug ? `/artists/${spot.artist.slug}/` : undefined}
            episodes={spot.artist.score} shows={spot.artist.shows} weeksAtOne={spot.artist.weeksAtOne} status={spot.artist.status} prevRank={spot.artist.prevRank} history={spot.artist.history} />
        )}
      </div>
    </section>
  )}

  {top && (
    <section class="section">
      <h2>Top 5</h2>
      <div class="grid-2">
        <div class="card">
          <h3>Tracks</h3>
          <RankedList items={top.tracks} movement />
          <p class="more"><a href={chartHref}>See the full chart →</a></p>
        </div>
        <div class="card">
          <h3>Artists</h3>
          <RankedList items={top.artists} movement />
          <p class="more"><a href={`${chartHref}#artists`}>See the full chart →</a></p>
        </div>
      </div>
    </section>
  )}

  {moves && (moves.climbers.length > 0 || moves.entries.length > 0) && (
    <section class="section">
      <h2>On the move</h2>
      <div class="grid-2">
        {moves.climbers.length > 0 && (
          <div class="card">
            <h3>Biggest climbers</h3>
            <RankedList items={moves.climbers} movement showKind />
          </div>
        )}
        {moves.entries.length > 0 && (
          <div class="card">
            <h3>New entries</h3>
            <RankedList items={moves.entries} movement showKind />
          </div>
        )}
      </div>
    </section>
  )}

  {headline.length > 0 && (
    <section class="section">
      <h2>In numbers</h2>
      <div class="stats headline" aria-label="Last 4 weeks in numbers">
        {headline.map((st) => <StatTile stat={st} />)}
      </div>
    </section>
  )}

  {mix.length > 0 && (
    <section class="section">
      <h2>Genre mix</h2>
      <TimeChart title="Top genres" caption="Share of episodes tagged with each genre, last 4 weeks. Hover for the change vs the previous 4 weeks." data={genreBars(mix)} height={Math.max(220, mix.length * 30)} />
    </section>
  )}

  {trends.series.length > 0 && (
    <section class="section">
      <h2>Genre trends</h2>
      <p class="muted">Share of each month's episodes, over the last 12 months. All charts use the same scale.</p>
      <div class="multiples">
        {trends.series.map((s) => <TimeChart title={s.genre} data={shareLine(s.months, s.shares, trends.max)} height={140} />)}
      </div>
    </section>
  )}

  {history.length > 0 && (
    <section class="section">
      <h2>This week, years ago</h2>
      <div class="multiples">
        {history.map((h) => (
          <div class="card">
            <h3><a href={`/charts/week/${h.key}/`}>{h.years === 1 ? "1 year ago" : `${h.years} years ago`}</a></h3>
            <p class="muted small">{periodLabel("week", h.key)}</p>
            {h.track && <p class="otd"><span class="spot-label">#1 track</span><br />{h.track.title} <span class="muted">— {h.track.artistDisplay}</span></p>}
            {h.artist && <p class="otd"><span class="spot-label">#1 artist</span><br />{h.artist.slug ? <a href={`/artists/${h.artist.slug}/`}>{h.artist.name}</a> : h.artist.name}</p>}
          </div>
        ))}
      </div>
    </section>
  )}

  {allTime.tracks.length > 0 && (
    <section class="section">
      <h2>Most played of all time</h2>
      <div class="grid-2">
        <div class="card">
          <h3>Tracks</h3>
          <RankedList items={allTime.tracks} />
          <p class="more"><a href="/charts/all/">Top 100 tracks →</a></p>
        </div>
        <div class="card">
          <h3>Artists</h3>
          <RankedList items={allTime.artists} />
          <p class="more"><a href="/charts/all/#artists">Top 100 artists →</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <h2>The archive</h2>
    <div class="stats" aria-label="Archive size">
      <div class="stat"><div class="label">Episodes with tracklists</div><div class="value">{stats.episodes.toLocaleString("en-GB")}</div></div>
      <div class="stat"><div class="label">Plays</div><div class="value">{stats.plays.toLocaleString("en-GB")}</div></div>
      <div class="stat"><div class="label">Tracks</div><div class="value">{stats.tracks.toLocaleString("en-GB")}</div></div>
      <div class="stat"><div class="label">Artists</div><div class="value">{stats.artists.toLocaleString("en-GB")}</div></div>
    </div>
    <p class="muted small" style="margin-top:0.75rem">Since {stats.first ? formatDate(stats.first) : "the start"}. <a href="/charts/">Browse every chart</a>.</p>
  </section>
</div>
</Base>
