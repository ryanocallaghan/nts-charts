---
import Base from "../../../layouts/Base.astro";
import ChartView from "../../../components/ChartView.astro";
import { dayKey, isoWeekStart, periodBounds, periodDates, periodHeading, periodLabel, seasonForQuarter, switchTargets, DATED_PERIODS, type DatedPeriod } from "../../../lib/format.ts";
import { asOf } from "../../../lib/overview.ts";
import PastYears from "../../../components/PastYears.astro";
import ChartFilters from "../../../components/ChartFilters.astro";
import BumpChart from "../../../components/BumpChart.astro";
import PeriodSwitcher from "../../../components/PeriodSwitcher.astro";
import RecordGenreNote from "../../../components/RecordGenreNote.astro";
import { byShows, filterDescription, filterLabel, filterParams, isFiltered, nearestPeriodKey, parseChartFilter, periodKeys } from "../../../lib/queries.ts";
import { dayRange, rangeParams, rangeYearsBefore } from "../../../lib/ranges.ts";

const type = Astro.params.type as DatedPeriod;
const key = Astro.params.key ?? "";
// Quarters became seasons: send old links to the season sharing most of their months.
if ((type as string) === "quarter") {
  const season = seasonForQuarter(key);
  return season ? Astro.redirect(`/charts/season/${season}/${Astro.url.search}`, 301) : new Response(null, { status: 404 });
}
if (!DATED_PERIODS.includes(type)) return new Response(null, { status: 404 });
const keys = periodKeys(type);
const i = keys.indexOf(key);
if (i < 0) return new Response(null, { status: 404 });

// Optional filters: ?genre=<slug>&by=shows&place=<name> (see parseChartFilter). Not for single weeks,
// which are too sparse to slice.
const params = Astro.url.searchParams;
const filterable = type !== "week";
if ((params.get("genre") || params.get("place")) && !filterable) return Astro.redirect(`/charts/${type}/${key}/`, 301);
const filter = parseChartFilter(params);
if (!filter) return new Response(null, { status: 404 });
const filtered = isFiltered(filter);
// Links to other charts keep the filter where it applies.
const query = (t: string) => (!filtered || t === "week" ? "" : `?${new URLSearchParams(filterParams(filter))}`);
const prev = keys[i - 1];
const next = keys[i + 1];

// Switching type keeps you at the same point in time: this chart's end, or the latest data while it's running.
const near = switchTargets(type, key, asOf());
// Same date label as the home page: the whole period, and how far the data goes while it's still running.
const dates = periodDates(type, key, asOf());
const heading = periodHeading(type, key, dates.inProgress);
const sub = [heading.sub.split(" · ")[0], dates.text].filter(Boolean).join(" · ");
// Short labels for previous/next: "Week 46", "October 2026", "2025", or "To 15 Nov" for 4-week charts.
const stepLabel = (k: string) => {
  if (type !== "rolling") return periodLabel(type, k).split(" · ")[0];
  const end = isoWeekStart(k);
  end.setUTCDate(end.getUTCDate() + 6);
  return `To ${end.getUTCDate()} ${end.toLocaleString("en-GB", { month: "short", timeZone: "UTC" })}`;
};
const hrefs = Object.fromEntries(DATED_PERIODS.map((t) => {
  const target = nearestPeriodKey(t, near[t]);
  return [t, target ? `/charts/${t}/${target}/${query(t)}` : "/charts/"];
})) as Record<DatedPeriod, string>;
// "Pick dates" starts from this chart's dates (up to the latest data), with its filter.
const bounds = periodBounds(type, key);
const lastDay = new Date(Math.min(bounds.end.getTime() - 86_400_000, asOf().getTime()));
const rangeHref = `/charts/range/?${new URLSearchParams({ from: dayKey(bounds.start), to: dayKey(lastDay), ...filterParams(filter) })}`;
// Months, seasons and years: compare with the same one a year earlier, over the same days while this one's running.
const lastYearKey = type === "year" ? String(Number(key) - 1) : type === "month" || type === "season" ? `${Number(key.slice(0, 4)) - 1}${key.slice(4)}` : null;
const thisRange = dayRange(bounds.start, new Date(Date.UTC(lastDay.getUTCFullYear(), lastDay.getUTCMonth(), lastDay.getUTCDate())));
const lastYearRange = lastYearKey && keys.includes(lastYearKey) ? rangeYearsBefore(thisRange, 1, new Date(0)) : null;
const compareHref = lastYearRange
  ? `/charts/compare/?${new URLSearchParams({ ...rangeParams(lastYearRange, "a_"), ...rangeParams(thisRange, "b_"), ...filterParams(filter) })}`
  : null;
---
<Base title={`${heading.title}${filtered ? ` · ${filterLabel(filter)}` : ""} · ${sub}`} section="charts">
  <h1>{heading.title}{filtered && <span class="filter-heading">{filterLabel(filter)}</span>}</h1>
  <p class="page-sub">{sub}{filtered && ` · ${filterDescription(filter)}`}</p>

  <div class="period-nav">
    <PeriodSwitcher hrefs={hrefs} rangeHref={rangeHref} current={type} />
    <nav class="stepper" aria-label="Previous and next chart">
      {prev ? <a class="cds--link" href={`/charts/${type}/${prev}/${query(type)}`} rel="prev">← {stepLabel(prev)}</a> : <span class="cds--link cds--link--disabled">← Earlier</span>}
      <span class="muted">·</span>
      {next ? <a class="cds--link" href={`/charts/${type}/${next}/${query(type)}`} rel="next">{stepLabel(next)} →</a> : <span class="cds--link cds--link--disabled">Later →</span>}
    </nav>
  </div>

  {filterable && <ChartFilters action={`/charts/${type}/${key}/`} filter={filter} />}
  {filter.genre && !byShows(filter) && <RecordGenreNote genre={filter.genre} range={bounds} showsHref={filter.genre.episodes > 0 ? `/charts/${type}/${key}/?${new URLSearchParams({ ...filterParams(filter), by: "shows" })}` : undefined} />}

  <ChartView type={type} periodKey={key} filter={filtered ? filter : undefined} />

  {(type === "rolling" || type === "week") && !filtered && <BumpChart type={type} periodKey={key} />}

  {compareHref && <p class="section"><a href={compareHref}>Compare with {periodLabel(type, lastYearKey!)} →</a> Side by side: what rose, fell, arrived and left.</p>}

  {type === "week" && <PastYears week={key} />}
  {type === "year" && <p class="section"><a href={`/years/${key}/`}>{key} in review →</a> New artists, biggest climbers, genres and the busiest shows.</p>}
</Base>
