---
import Base from "../../layouts/Base.astro";
import ShowBody from "../../components/ShowBody.astro";
import SearchField from "../../components/SearchField.astro";
import { ntsShowUrl, plural } from "../../lib/format.ts";
import { allShows, GUESTS_SHOW, guestPages, showDetail, type ShowRow } from "../../lib/queries.ts";

export function getStaticPaths() {
  return allShows().map((s) => ({ params: { alias: s.alias }, props: { show: s } }));
}

const { show } = Astro.props as { show: ShowRow };
const d = showDetail(show.alias);
const isGuests = show.alias === GUESTS_SHOW;
const repeatGuests = isGuests ? [...guestPages().values()] : [];
---
<Base title={show.name} description={isGuests ? "Guest mixes on NTS Radio: every repeat guest, and the latest guest mixes with their tracklists." : `What ${show.name} plays on NTS Radio: most-played artists and tracks, and recent tracklists.`} section="shows">
  <article>
    <p class="eyebrow">Show{show.location && ` · ${show.location}`}</p>
    <h1>{show.name}</h1>
    {isGuests && <p class="lede">NTS files one-off guest mixes under this show. Each guest counts as their own show in charts and on artist pages.</p>}
    {show.genres.length > 0 && <p class="muted">{show.genres.join(" · ")}</p>}
    <p><a href={ntsShowUrl(show.alias)}>Listen on nts.live →</a></p>

    {isGuests && repeatGuests.length > 0 && (
      <section class="card section">
        <h2>Repeat guests</h2>
        <p class="caption muted">{plural(repeatGuests.length, "guest")} with more than one mix.</p>
        <SearchField label="Filter guests" data-filter="#guest-list" />
        <ul class="plain columns" id="guest-list" data-collapse-list="20">
          {repeatGuests.map((g) => <li data-name={g.name.toLowerCase()}><a href={`/shows/guests/${g.slug}/`}>{g.name}</a><span class="count">{plural(g.mixes, "mix", "mixes")}</span></li>)}
        </ul>
      </section>
    )}

    <ShowBody show={show.alias} detail={d} moreHref={ntsShowUrl(show.alias)} episodesLabel={isGuests ? "Latest guest mixes" : "Recent episodes"} />
  </article>
</Base>

<script>
  for (const input of document.querySelectorAll<HTMLInputElement>("input[data-filter]")) {
    const list = document.querySelector(input.dataset.filter!);
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      list?.classList.toggle("filtering", !!q); // search every guest, not just the ones shown
      for (const li of list?.querySelectorAll<HTMLElement>("li") ?? []) li.hidden = !!q && !li.dataset.name!.includes(q);
    });
  }
</script>

<script>
  import "../../scripts/collapse.ts";
</script>
