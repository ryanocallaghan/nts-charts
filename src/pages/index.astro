---
import Base from "../layouts/Base.astro";
import ChartView from "../components/ChartView.astro";
import { currentPeriodKey, formatDate, periodLabel } from "../lib/format.ts";
import { periodKeys, siteStats } from "../lib/queries.ts";

const weeks = periodKeys("week");
const latest = weeks.at(-1);
const inProgress = latest === currentPeriodKey("week");
const stats = siteStats();
---
<Base title="NTS Charts" section="charts">
  <p class="eyebrow">Weekly chart</p>
  <h1>{latest ? periodLabel("week", latest) : "No charts yet"} {inProgress && <span class="badge">In progress</span>}</h1>
  <p class="lede">
    The tracks and artists played on the most NTS Radio episodes this week. A track scores once per episode that plays
    it, so one show repeating a record doesn't top the chart.
  </p>

  {latest && (
    <>
      <ChartView type="week" periodKey={latest} />
      <p class="section"><a href={`/charts/week/${latest}/`}>Full week view</a> · <a href="/charts/">Browse every chart since {stats.first ? formatDate(stats.first).split(" ").at(-1) : "the start"}</a></p>
    </>
  )}

  <div class="stats section" aria-label="Archive size">
    <div class="stat"><div class="label">Episodes with tracklists</div><div class="value">{stats.episodes.toLocaleString("en-GB")}</div></div>
    <div class="stat"><div class="label">Plays</div><div class="value">{stats.plays.toLocaleString("en-GB")}</div></div>
    <div class="stat"><div class="label">Tracks</div><div class="value">{stats.tracks.toLocaleString("en-GB")}</div></div>
    <div class="stat"><div class="label">Artists</div><div class="value">{stats.artists.toLocaleString("en-GB")}</div></div>
  </div>
</Base>
