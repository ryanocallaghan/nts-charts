---
import Base from "../layouts/Base.astro";
---
<Base title="Search" section="search">
  <h1>Search</h1>
  <p class="lede">Find an artist or show.</p>
  <label class="visually-hidden" for="q">Artist or show name</label>
  <input id="q" class="filter" type="search" placeholder="Artist or show name" autocomplete="off" autofocus />
  <p class="muted" id="status" aria-live="polite"></p>
  <ul class="plain" id="results"></ul>
  <noscript><p class="muted">Search needs JavaScript. You can also browse <a href="/shows/">all shows</a>.</p></noscript>
</Base>

<script>
  type Entry = { n: string; u: string; k: "a" | "s"; e: number };
  const norm = (s: string) => s.normalize("NFKD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();

  const input = document.getElementById("q") as HTMLInputElement;
  const status = document.getElementById("status")!;
  const results = document.getElementById("results")!;
  let index: (Entry & { key: string })[] = [];

  function render() {
    const q = norm(input.value);
    results.replaceChildren();
    if (!q) { status.textContent = ""; return; }
    // Whole-name prefix beats word prefix beats anywhere; then the most-played first.
    const scored = [];
    for (const it of index) {
      const at = it.key.indexOf(q);
      if (at < 0) continue;
      const tier = at === 0 ? 0 : it.key[at - 1] === " " ? 1 : 2;
      scored.push({ it, tier });
    }
    scored.sort((a, b) => a.tier - b.tier || b.it.e - a.it.e);
    status.textContent = scored.length ? `${scored.length.toLocaleString("en-GB")} match${scored.length === 1 ? "" : "es"}` : "No matches.";
    for (const { it } of scored.slice(0, 50)) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `/${it.k === "a" ? "artists" : "shows"}/${it.u}/`;
      a.textContent = it.n;
      const meta = document.createElement("span");
      meta.className = "count";
      meta.textContent = `${it.k === "a" ? "Artist" : "Show"} · ${it.e.toLocaleString("en-GB")} episode${it.e === 1 ? "" : "s"}`;
      li.append(a, meta);
      results.append(li);
    }
  }

  status.textContent = "Loading…";
  fetch("/search-index.json")
    .then((r) => r.json())
    .then((data: Entry[]) => {
      index = data.map((d) => ({ ...d, key: norm(d.n) }));
      const fromUrl = new URLSearchParams(location.search).get("q");
      if (fromUrl && !input.value) input.value = fromUrl;
      render();
    })
    .catch(() => { status.textContent = "Search couldn't load. Try again later, or browse all shows."; });

  input.addEventListener("input", () => {
    render();
    const url = new URL(location.href);
    input.value ? url.searchParams.set("q", input.value) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  });
</script>
