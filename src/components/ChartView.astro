---
// One period's track + artist charts with a tab switch.
import type { PeriodType } from "../lib/format.ts";
import { artistChart, episodesForTracks, filteredChart, rankHistories, trackChart, type ArtistEntry, type ChartFilter, type TrackEntry } from "../lib/queries.ts";
import ArtistTable from "./ArtistTable.astro";
import Tabs from "./Tabs.astro";
import TrackTable from "./TrackTable.astro";

// `initial`: show N rows at a time, with a button to reveal N more (all rows are in the page, just hidden).
// `filter`: narrow the chart to a genre and/or place (worked out on request; dated periods only).
// `range`: a chart for any dates, already ranked (rangeChart()), instead of a period's.
interface Range { start: Date; end: Date; tracks: TrackEntry[]; artists: ArtistEntry[]; movement: boolean }
interface Props { type: PeriodType; periodKey: string; limit?: number; initial?: number; filter?: ChartFilter; range?: Range }
const { type, periodKey, limit = type === "all" ? 100 : 50, initial, filter, range } = Astro.props;
const noun = { week: "Week", rolling: "Week", month: "Month", season: "Season", year: "Year", all: "" }[type];
const movement = range ? range.movement : type !== "all";
const filtered = range ? range : filter && type !== "all" ? filteredChart(type, periodKey, filter) : null;
const tracks = filtered ? filtered.tracks.slice(0, limit) : trackChart(type, periodKey, limit);
const artists = filtered ? filtered.artists.slice(0, limit) : artistChart(type, periodKey, limit);
const plays = episodesForTracks(tracks.map((t) => t.id), {
  ...(range ? { range: { start: range.start, end: range.end } } : { type, key: periodKey }),
  filter: filtered ? filter : undefined,
});
// Rank trends over the last 8 charts of this type (not for all time, which is a single chart).
const SPARK = 8;
const trackRuns = movement && !filtered ? rankHistories(type, periodKey, "track", tracks.map((t) => t.id), SPARK) : undefined;
const artistRuns = movement && !filtered ? rankHistories(type, periodKey, "artist", artists.map((a) => a.id), SPARK) : undefined;
const id = range ? "chart-range" : `chart-${type}-${periodKey}`;
---
<Tabs id={id} tabs={[{ key: "tracks", label: "Tracks" }, { key: "artists", label: "Artists" }]} />
<div class="chart-panels">
  <div class="tabpanel" id={`${id}-tracks`} role="tabpanel" aria-labelledby={`${id}-tab-tracks`}>
    <div data-collapsible={initial && tracks.length > initial ? "" : undefined}>
      <TrackTable rows={tracks} periodNoun={noun} movement={movement} periods={movement && !filtered} plays={plays} runs={trackRuns} runCount={SPARK} />
      {initial && tracks.length > initial && <button type="button" class="cds--btn cds--btn--ghost cds--btn--md show-all" hidden data-step={initial} data-less={`Show top ${initial}`}></button>}
    </div>
  </div>
  <div class="tabpanel" id={`${id}-artists`} role="tabpanel" aria-labelledby={`${id}-tab-artists`}>
    <div data-collapsible={initial && artists.length > initial ? "" : undefined}>
      <ArtistTable rows={artists} periodNoun={noun} movement={movement} periods={movement && !filtered} runs={artistRuns} runCount={SPARK} />
      {initial && artists.length > initial && <button type="button" class="cds--btn cds--btn--ghost cds--btn--md show-all" hidden data-step={initial} data-less={`Show top ${initial}`}></button>}
    </div>
  </div>
</div>

<script>
  // Show long charts a step (10) of rows at a time; without JS every row stays visible.
  for (const box of document.querySelectorAll<HTMLElement>("[data-collapsible]")) {
    const button = box.querySelector<HTMLButtonElement>("button.show-all");
    const rows = [...box.querySelectorAll<HTMLTableRowElement>("tbody tr")];
    if (!button || !rows.length) continue;
    const STEP = Number(button.dataset.step) || 10;
    let shown = 0;
    const show = (n: number) => {
      shown = Math.min(n, rows.length);
      rows.forEach((tr, i) => (tr.hidden = i >= shown));
      const all = shown >= rows.length;
      const next = Math.min(STEP, rows.length - shown);
      button.textContent = all ? button.dataset.less! : `Show ${next} more (${shown + 1}–${shown + next} of ${rows.length})`;
      button.setAttribute("aria-expanded", String(all));
    };
    show(STEP);
    button.hidden = false;
    button.addEventListener("click", () => {
      if (shown < rows.length) return show(shown + STEP);
      show(STEP);
      // Back to the top 10: keep the table's top in view instead of leaving the reader far down the page.
      if (box.getBoundingClientRect().top < 0) box.scrollIntoView({ block: "start" });
    });
  }
</script>
