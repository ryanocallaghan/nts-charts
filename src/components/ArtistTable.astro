---
import type { ArtistEntry } from "../lib/queries.ts";
import Movement from "./Movement.astro";
import RankSpark from "./RankSpark.astro";
interface Props { movement?: boolean; periods?: boolean; rows: ArtistEntry[]; periodNoun: string; runs?: Map<number, (number | null)[]>; runCount?: number }
const { rows, periodNoun, movement = true, periods = movement, runs, runCount = 8 } = Astro.props;
---
{rows.length === 0 ? <p class="muted">No artists charted in this period yet.</p> : (
  <div class="cds--data-table-container chart-table">
  <table class="cds--data-table cds--data-table--lg chart">
    <thead>
      <tr>
        <th class="rank">#</th>
        {movement && <th class="mv"><span class="visually-hidden">Movement</span></th>}
        <th>Artist</th>
        <th class="num" title="Distinct episodes that played them"><span class="h-lg">Episodes</span><span class="h-sm">Eps</span></th>
        <th class="num hide-sm" title="Distinct shows that played them">Shows</th>
        {runs && <th class="spark hide-sm" title={`Rank in each of the last ${runCount} charts`}>Last {runCount}</th>}
        {periods && <th class="num hide-sm" title={`${periodNoun}s on chart`}>{periodNoun}s</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="rank">{r.rank}{movement && <span class="rank-move"><Movement status={r.status} rank={r.rank} prevRank={r.prevRank} /></span>}</td>
          {movement && <td class="mv"><Movement status={r.status} rank={r.rank} prevRank={r.prevRank} /></td>}
          <td class="title"><a href={`/artists/${r.slug}/`}>{r.name}</a></td>
          <td class="num">{r.score}</td>
          <td class="num hide-sm">{r.shows}</td>
          {runs && <td class="spark hide-sm"><RankSpark ranks={runs.get(r.id)} /></td>}
          {periods && <td class="num hide-sm">{r.periodsOnChart}</td>}
        </tr>
      ))}
    </tbody>
  </table>
  </div>
)}
