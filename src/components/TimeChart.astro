---
// Interactive time-series chart (hover tooltip, zoom on long ranges) with a data-table fallback.
import type { VizData } from "../scripts/charts.ts";
import { formatViz } from "../lib/series.ts";
interface Props {
  title: string;
  caption?: string;
  data: VizData;
  height?: number;
  bare?: boolean;          // no card or visible heading (when embedded in another tile)
  labelHeader?: string;    // data table's first column
}
const { title, caption, data, height = 260, bare = false, labelHeader = data.kind === "hbar" ? "Genre" : "Period" } = Astro.props;
const Wrapper = bare ? "div" : "section";
const fmt = (v: number | null) => formatViz(data.kind, v);
const rows = data.x.map((_, i) => ({ label: data.tip[i], value: data.y[i] })).filter((r) => r.value != null);
---
<Wrapper class:list={[bare ? "viz-bare" : "card viz-card"]}>
  {bare ? <h3 class="visually-hidden">{title}</h3> : <h2>{title}</h2>}
  {caption && <p class="caption">{caption}</p>}
  <div class="viz" style={`height:${height}px`} data-viz={JSON.stringify(data)} role="img" aria-label={`${title}. Data table below.`}></div>
  <details class="data-table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th>{labelHeader}</th><th>{data.name}</th></tr></thead>
      <tbody>{rows.map((r) => <tr><td>{r.label}</td><td>{fmt(r.value)}</td></tr>)}</tbody>
    </table>
  </details>
</Wrapper>

<script>
  import "../scripts/charts.ts";
</script>
