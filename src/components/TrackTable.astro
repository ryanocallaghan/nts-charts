---
import type { EpisodePlay, TrackEntry } from "../lib/queries.ts";
import EpisodePlays from "./EpisodePlays.astro";
import ArtistLinks from "./ArtistLinks.astro";
import Movement from "./Movement.astro";
import RankSpark from "./RankSpark.astro";
import { trackHref } from "../lib/search.ts";
interface Props { movement?: boolean; rows: TrackEntry[]; periodNoun: string; plays?: Map<number, { total: number; episodes: EpisodePlay[] }>; runs?: Map<number, (number | null)[]>; runCount?: number }
const { rows, periodNoun, movement = true, plays, runs, runCount = 8 } = Astro.props;
---
{rows.length === 0 ? <p class="muted">No tracks charted in this period yet.</p> : (
  <div class="cds--data-table-container chart-table">
  <table class="cds--data-table cds--data-table--lg chart">
    <thead>
      <tr>
        <th class="rank">#</th>
        {movement && <th class="mv"><span class="visually-hidden">Movement</span></th>}
        <th>Track</th>
        <th class="num" title="Distinct episodes that played it"><span class="h-lg">Episodes</span><span class="h-sm">Eps</span></th>
        <th class="num hide-sm" title="Distinct shows that played it">Shows</th>
        {runs && <th class="spark hide-sm" title={`Rank in each of the last ${runCount} charts`}>Last {runCount}</th>}
        {movement && <th class="num hide-sm" title={`${periodNoun}s on chart`}>{periodNoun}s</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="rank">{r.rank}{movement && <span class="rank-move"><Movement status={r.status} rank={r.rank} prevRank={r.prevRank} /></span>}</td>
          {movement && <td class="mv"><Movement status={r.status} rank={r.rank} prevRank={r.prevRank} /></td>}
          <td>
            <div class="title"><a href={trackHref(r)}>{r.title}</a></div>
            <div class="sub"><ArtistLinks artists={r.artists} fallback={r.artistDisplay} /></div>
            <EpisodePlays plays={plays?.get(r.id)} label="Episodes" />
          </td>
          <td class="num">{r.score}</td>
          <td class="num hide-sm">{r.shows}</td>
          {runs && <td class="spark hide-sm"><RankSpark ranks={runs.get(r.id)} /></td>}
          {movement && <td class="num hide-sm">{r.periodsOnChart}</td>}
        </tr>
      ))}
    </tbody>
  </table>
  </div>
)}
