---
import "../styles/global.css";
import { formatDate } from "../lib/format.ts";
import { lastUpdated } from "../lib/queries.ts";

interface Props {
  title: string;
  description?: string;
  section?: "charts" | "all" | "archive" | "shows" | "search";
}
const { title, description = "Charts of the tracks and artists played on NTS Radio.", section } = Astro.props;
const updated = lastUpdated();
const nav = [
  { href: "/", label: "Latest", key: "charts" },
  { href: "/charts/all/", label: "All time", key: "all" },
  { href: "/charts/", label: "Archive", key: "archive" },
  { href: "/shows/", label: "Shows", key: "shows" },
  { href: "/search/", label: "Search", key: "search" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "NTS Charts" ? title : `${title} · NTS Charts`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='4' y='14' width='6' height='14' rx='2' fill='%232a78d6'/><rect x='13' y='6' width='6' height='22' rx='2' fill='%232a78d6'/><rect x='22' y='10' width='6' height='18' rx='2' fill='%232a78d6'/></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">NTS Charts</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={section === n.key ? "page" : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          An unofficial fan project built from public NTS Radio tracklists. Not affiliated with or endorsed by NTS.
          Listen at <a href="https://www.nts.live">nts.live</a>.
        </p>
        {updated && <p>Data updated {formatDate(updated)}.</p>}
      </div>
    </footer>
  </body>
</html>
