---
// Rendered on the server for /search/?q=…, so it works without JavaScript; the script below
// updates the results as you type.
import Base from "../layouts/Base.astro";
import SearchField from "../components/SearchField.astro";
import { search } from "../lib/queries.ts";
import { searchStatus } from "../lib/search.ts";

const q = (Astro.url.searchParams.get("q") ?? "").slice(0, 200);
const r = q.trim() ? search(q) : null;
---
<Base title={q.trim() ? `Search: ${q.trim()}` : "Search"} section="search">
  <h1>Search</h1>
  <p class="lede">Find any artist or show played on NTS.</p>
  <form action="/search/" method="get" role="search">
    <SearchField id="q" name="q" value={q} label="Artist or show name" autofocus />
  </form>
  <p class="muted" id="status" aria-live="polite">{r ? searchStatus(r) : ""}</p>
  <ul class="plain" id="results">
    {r?.results.map((x) => <li><a href={x.href}>{x.name}</a><span class="count">{x.meta}</span></li>)}
  </ul>
</Base>

<script>
  import type { SearchResult } from "../lib/search.ts";

  const input = document.getElementById("q") as HTMLInputElement;
  const status = document.getElementById("status")!;
  const results = document.getElementById("results")!;

  let seq = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  async function render() {
    const mine = ++seq;
    const q = input.value.trim();
    if (!q) { results.replaceChildren(); status.textContent = ""; return; }
    try {
      const res = await fetch(`/api/search.json?q=${encodeURIComponent(q)}`);
      const data = (await res.json()) as { status: string; results: SearchResult[] };
      if (mine !== seq) return;
      status.textContent = data.status;
      results.replaceChildren(
        ...data.results.map((x) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = x.href;
          a.textContent = x.name;
          const meta = document.createElement("span");
          meta.className = "count";
          meta.textContent = x.meta;
          li.append(a, meta);
          return li;
        }),
      );
    } catch {
      if (mine === seq) status.textContent = "Search isn't working right now. Press Enter to try again.";
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(render, 120);
    const url = new URL(location.href);
    input.value ? url.searchParams.set("q", input.value) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  });
</script>
