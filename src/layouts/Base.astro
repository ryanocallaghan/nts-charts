---
import "../styles/carbon.scss";
import "../styles/global.css";
import { formatDate, SITE_NAME } from "../lib/format.ts";
import { lastUpdated, periodKeys } from "../lib/queries.ts";
import HeaderSearch from "../components/HeaderSearch.astro";

interface Props {
  title: string;
  description?: string;
  section?: "home" | "charts" | "all" | "archive" | "shows" | "genres" | "search";
  // The home page's ASCII logo is the brand there: the header keeps the wordmark's space (so the menu
  // never moves) but only shows it once that logo has scrolled out of view.
  hideWordmark?: boolean;
}
const { title, description = "Charts of the tracks and artists played on NTS Radio.", section, hideWordmark = false } = Astro.props;
const updated = lastUpdated();
const latestChart = periodKeys("rolling").at(-1);
// Umami analytics (cookie-free, on the same server; see README): its website ID, read when the page is
// rendered. Unset: no analytics script.
const umamiId = process.env.UMAMI_WEBSITE_ID || null;
const nav = [
  { href: "/", label: "Home", key: "home" },
  { href: latestChart ? `/charts/rolling/${latestChart}/` : "/charts/", label: "Charts", key: "charts" },
  { href: "/charts/all/", label: "All time", key: "all" },
  { href: "/charts/", label: "Archive", key: "archive" },
  { href: "/shows/", label: "Shows", key: "shows" },
  { href: "/genres/", label: "Genres", key: "genres" },
  { href: "/search/", label: "Search", key: "search" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {umamiId && (
      // Served from this site (Caddy passes /s/ to Umami). Without query strings: searches and filters are events.
      <script is:inline defer src="/s/app.js" data-website-id={umamiId} data-host-url="/s" data-domains="nts.ryanocallaghan.com" data-exclude-search="true" data-exclude-hash="true"></script>
    )}
  </head>
  <body>
    <header class="cds--header site-header" aria-label={SITE_NAME} data-defer-logo={hideWordmark ? "" : undefined}>
      <div class="header-inner">
        <a class="cds--header__name site-logo" href="/">
          <span class="visually-hidden">{SITE_NAME}</span>
          <span class="wordmark" aria-hidden="true">¡ [ TOP ] [ of | the ] [ NTS ] !</span>
        </a>
      <nav class="cds--header__nav" aria-label="Main">
        <ul class="cds--header__menu-bar">
          {nav.map((n) => (
            <li class:list={{ "nav-search": n.key === "search" }}>
              <a class:list={["cds--header__menu-item", { "cds--header__menu-item--current": section === n.key }]} href={n.href} aria-current={section === n.key ? "page" : undefined}>
                <span class="cds--text-truncate--end">{n.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {section !== "search" && <HeaderSearch id="site-search" class="header-search-wide" />}
      {/* Phones: the inline menu doesn't fit, so a Menu button opens the full list. Works without JS. */}
      <details class="mobile-menu">
        <summary class="mobile-menu-button">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false" fill="currentColor"><rect x="2" y="4" width="16" height="1.5"/><rect x="2" y="9.25" width="16" height="1.5"/><rect x="2" y="14.5" width="16" height="1.5"/></svg>
          <span>Menu</span>
        </summary>
        <nav class="mobile-menu-panel" aria-label="Main">
          {section !== "search" && <HeaderSearch id="menu-search" class="header-search-menu" />}
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={section === n.key ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
      </div>
    </header>
    <script is:inline>
      // Close the phone menu on Escape, on a tap outside it, or after choosing a link.
      (function () {
        var menu = document.querySelector(".mobile-menu");
        if (!menu) return;
        document.addEventListener("keydown", function (e) { if (e.key === "Escape" && menu.open && !e.defaultPrevented) { menu.open = false; menu.querySelector("summary").focus(); } });
        document.addEventListener("click", function (e) { if (menu.open && !menu.contains(e.target)) menu.open = false; });
        menu.addEventListener("click", function (e) { if (e.target.closest && e.target.closest("a")) menu.open = false; });
      })();
    </script>
    {hideWordmark && (
      <script is:inline>
        // Hide the header wordmark (keeping its space) while the page's own logo is on screen.
        // Runs before the page paints; without JavaScript the wordmark simply stays visible.
        (function () {
          var header = document.querySelector("[data-defer-logo]");
          if (!header) return;
          header.classList.add("defer-logo");
          var logo;
          function update() {
            logo = logo || document.querySelector(".hero-logo");
            // Show the wordmark once the page's logo has scrolled up under the header (one cheap measurement).
            header.classList.toggle("show-logo", !logo || logo.getBoundingClientRect().bottom < header.offsetHeight);
          }
          // Only animate after the first paint, so the wordmark doesn't fade out on page load.
          requestAnimationFrame(function () { requestAnimationFrame(function () { header.classList.add("logo-anim"); }); });
          addEventListener("scroll", update, { passive: true });
          addEventListener("resize", update);
          document.addEventListener("DOMContentLoaded", update);
        })();
      </script>
    )}
    <script>
      import "../scripts/suggest.ts";
      import "../scripts/collapse.ts";
      import "../scripts/analytics.ts";
    </script>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          A personal project built from public NTS Radio tracklists. Not affiliated with NTS.
          Listen at <a href="https://www.nts.live">nts.live</a>.
        </p>
        <p>Artist info from <a href="https://musicbrainz.org">MusicBrainz</a> and <a href="https://en.wikipedia.org">Wikipedia</a>; credited on each artist page. Record genres: data provided by <a href="https://www.discogs.com/">Discogs</a>.</p>
        {umamiId && <p>Visits are counted with <a href="https://umami.is">Umami</a>, without cookies.</p>}
        {updated && <p>Data updated {formatDate(updated)}.</p>}
      </div>
    </footer>
  </body>
</html>
