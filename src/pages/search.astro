---
import Base from "../layouts/Base.astro";
---
<Base title="Search" section="search">
  <h1>Search</h1>
  <p class="lede">Find an artist or show.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search"></div>
  <noscript><p class="muted">Search needs JavaScript. You can also browse <a href="/shows/">all shows</a>.</p></noscript>
  <p class="muted" id="search-missing" hidden>The search index is generated by <code>npm run build</code>, so it isn't available in dev mode.</p>
</Base>

<script is:inline>
  (function () {
    var s = document.createElement("script");
    s.src = "/pagefind/pagefind-ui.js";
    s.onload = function () {
      new PagefindUI({ element: "#search", showSubResults: false, showImages: false, resetStyles: false });
    };
    s.onerror = function () {
      document.getElementById("search-missing").hidden = false;
    };
    document.head.appendChild(s);
  })();
</script>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--link);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--grid);
    --pagefind-ui-tag: var(--page);
    --pagefind-ui-font: var(--font);
    --pagefind-ui-border-radius: 8px;
  }
</style>
